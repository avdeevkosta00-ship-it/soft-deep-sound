{
  "name": "soft-deep-sound",
  "productName": "Soft&Deep Sound",
  "version": "1.11.1",
  "description": "Soft&Deep Sound — desktop music player",
  "main": "main.js",
  "author": "Konstantin",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win nsis portable --publish never",
    "dist:dir": "electron-builder --win dir --publish never"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "music-metadata": "7.14.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.konstantin.softdeepsound",
    "productName": "Soft&Deep Sound",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "build/*.png",
      "package.json"
    ],
    "win": {
      "icon": "build/*.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Soft&Deep Sound",
      "artifactName": "SoftDeepSound-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "wav",
          "ogg",
          "m4a"
        ],
        "name": "Audio",
        "role": "Viewer"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "portable": {
      "artifactName": "SoftDeepSound-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "infallibl3",
        "repo": "soft-deep-sound"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/infallibl3/soft-deep-sound.git"
  }
}
